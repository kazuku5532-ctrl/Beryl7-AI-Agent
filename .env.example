# ==================================================
# Beryl 7 Autonomous Remediation Agent Configuration
# ==================================================

# Router Target Configuration
ROUTER_IP=192.168.8.1
ROUTER_USER=root

# SSH Key Authentication (Recommended over password)
SSH_KEY_PATH=~/.ssh/beryl7_rsa
SSH_KEY_PASSPHRASE=

# Fallback Password Authentication (If SSH Key unavailable)
ROUTER_PASSWORD=your-router-admin-password

# Google Gemini 2.5 Flash API Key (Required for Cloud Diagnostics)
GEMINI_API_KEY=your-gemini-api-key-here

# Security Tokens (Auto-generated if left empty)
AUTH_TOKEN=
APPROVE_TOKEN=

# System Operating Parameters
LOG_LEVEL=INFO
DISABLE_AUTO_HEALING=false
