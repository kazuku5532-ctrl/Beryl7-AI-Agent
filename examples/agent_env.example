# Beryl 7 AI Agent Environment Configuration File Example
# Save to /etc/beryl7/agent.env with permission 0600 (chmod 0600 /etc/beryl7/agent.env)

AUTH_TOKEN=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
APPROVE_TOKEN=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210
LOG_LEVEL=INFO
HEALTH_PORT=8888
BIND_HOST=127.0.0.1
GEMINI_API_KEY=your_gemini_api_key_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Dynamic Anomaly Threshold Overrides
BERYL7_RAM_EXHAUSTION_PCT=92.0
BERYL7_CPU_SPIKE_LOAD=1.5
BERYL7_LATENCY_SPIKE_MS=100.0
BERYL7_LATENCY_ZSCORE=2.5
BERYL7_BANDWIDTH_BOOST_MBPS=80.0
BERYL7_BANDWIDTH_RESTORE_MBPS=20.0
BERYL7_WIFI_DISCONNECT_COUNT=3

# Log Rotation Overrides
BERYL7_LOG_MAX_BYTES=2097152
BERYL7_LOG_BACKUP_COUNT=5
